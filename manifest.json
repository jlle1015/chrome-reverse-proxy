{
  "manifest_version": 3,
  "name": "Chrome Reverse Proxy",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "description": "浏览器内反向代理：Background 代理 + Content Script 重写，规避跨域并携带/添加请求头。",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "js/background.js"
  },
  "side_panel": {
    "default_path": "html/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["js/content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["js/page-proxy.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "options_page": "html/options.html",
  "action": {
    "default_popup": "html/popup.html",
    "default_title": "Chrome Reverse Proxy"
  }
}
